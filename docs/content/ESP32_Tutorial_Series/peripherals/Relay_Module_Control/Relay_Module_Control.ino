/*
 * 教程：继电器模块控制
 *
 * 学习目标：
 * 1. 了解继电器是什么，以及为什么要用继电器。
 * 2. 理解继电器的常开（NO）、常闭（NC）、公共端（COM）触点。
 * 3. 学会用低电平触发和高电平触发两种继电器模块。
 * 4. 安全地用 ESP32 控制大功率设备（如灯、风扇、水泵）。
 *
 * 所需库：
 * 本例不需要额外库。
 *
 * 硬件连接：
 * - 继电器模块 VCC  →  ESP32 5V（部分模块也支持 3.3V，请查看模块丝印）
 * - 继电器模块 GND  →  ESP32 GND
 * - 继电器模块 IN   →  ESP32 GPIO27
 *
 * 继电器输出端（以控制一盏 220V 灯为例）：
 * - 火线（L） →  继电器 COM
 * - 继电器 NO →  灯的一端
 * - 灯的另外一端 →  零线（N）
 *
 * 警告：
 * 220V 市电有触电危险！
 * 如果你是初学者，建议先用低压设备（如 5V 小风扇、9V 电池供电的灯泡）练习。
 * 接线前务必断开电源，继电器吸合时也不要触摸任何金属端子。
 */

// RELAY_PIN：连接继电器 IN 引脚的 GPIO。
// GPIO27 是通用 GPIO，选择它只是因为它靠近 5V/GND，方便接线。
#define RELAY_PIN 27

// RELAY_ON：让继电器吸合（闭合）时要输出的电平。
// 市面上大部分继电器模块是"低电平触发"，也就是 IN 为 LOW 时继电器吸合。
// 如果你的模块是"高电平触发"，请把这里改成 HIGH，并把 RELAY_OFF 改成 LOW。
#define RELAY_ON LOW

// RELAY_OFF：让继电器释放（断开）时要输出的电平。
// 与 RELAY_ON 相反即可。
#define RELAY_OFF HIGH

void setup() {
  Serial.begin(115200);
  delay(1000);

  // 把继电器控制引脚设为输出，因为 ESP32 要主动控制它的高低电平。
  pinMode(RELAY_PIN, OUTPUT);

  // 初始化时让继电器处于关闭状态，避免一上电就意外吸合。
  digitalWrite(RELAY_PIN, RELAY_OFF);

  Serial.println("继电器模块初始化完成");
  Serial.println("注意：大多数模块是低电平触发，即输出 LOW 时吸合。");
}

void loop() {
  // 吸合继电器，外部电路接通。
  digitalWrite(RELAY_PIN, RELAY_ON);
  Serial.println("继电器吸合 → 外部设备通电");

  // 保持 2 秒，让外部设备持续工作一段时间。
  delay(2000);

  // 释放继电器，外部电路断开。
  digitalWrite(RELAY_PIN, RELAY_OFF);
  Serial.println("继电器释放 → 外部设备断电");

  // 再保持 2 秒断开，形成通断循环。
  delay(2000);
}

/*
 * 名词解释：
 * 继电器（Relay）：
 * 一种用"小电流控制大电流"的电控开关。
 * ESP32 GPIO 只能提供几十毫安电流，无法直接驱动 220V 灯或水泵，
 * 但可以通过继电器控制大功率电路的通断。
 *
 * 常开触点（NO，Normally Open）：
 * 继电器没有通电时，COM 和 NO 之间是断开的；通电吸合后，COM 和 NO 才接通。
 * 适合"按下按钮才开灯"的场景。
 *
 * 常闭触点（NC，Normally Closed）：
 * 继电器没有通电时，COM 和 NC 之间是接通的；吸合后断开。
 * 适合"默认通电，触发后断电"的场景。
 *
 * 公共端（COM，Common）：
 * 继电器触点的公共连接点，必须接入被控电路的一侧。
 */

