/*
 * ESP32 教程系列 01：数字输出 - 点亮 LED（Blink）
 *
 * 学习目标：
 * 1. 理解什么是 GPIO，以及 ESP32 的引脚如何编号
 * 2. 理解 pinMode() 的作用，学会把引脚设为输出模式
 * 3. 理解 digitalWrite() 如何输出高/低电平
 * 4. 理解 delay() 的延时作用，观察 LED 闪烁效果
 * 5. 学会通过串口监视器查看程序运行状态
 *
 * 前置知识：
 * - 已安装 Arduino IDE 并配置好 ESP32 开发板支持
 * - 知道如何把代码上传到 ESP32 开发板
 *
 * 关键概念解释：
 *
 * 【GPIO 是什么？】
 * GPIO 是 General Purpose Input/Output（通用输入/输出）的缩写。
 * 你可以把它理解为 ESP32 芯片上的一根根"腿"，每根腿都可以：
 * - 作为输入：读取外部信号（比如按键是否被按下）
 * - 作为输出：控制外部设备（比如点亮 LED）
 * ESP32 开发板上的引脚旁边通常印有 GPIO 编号，比如 GPIO2、GPIO4 等。
 * 本教程使用 GPIO2，因为大多数 ESP32 开发板的板载 LED 都接在这个引脚上。
 *
 * 【数字信号 HIGH / LOW】
 * 数字信号只有两种状态：
 * - HIGH（高电平）：引脚输出约 3.3V 电压
 * - LOW（低电平）：引脚输出约 0V 电压
 * LED 只有正负极之间有电压差时才会发光。
 * 当 GPIO2 输出 HIGH 时，电流从 GPIO2 流向 LED 正极，再经过电阻流向 GND，LED 点亮。
 * 当 GPIO2 输出 LOW 时，引脚和 GND 之间几乎没有电压差，LED 熄灭。
 *
 * 【setup() 和 loop()】
 * Arduino 程序（Sketch）必须包含两个特殊函数：
 * - setup()：只在开发板上电或按下复位键时执行一次，用来初始化配置
 * - loop()：setup() 执行完后会无限循环执行，用来放主逻辑
 *
 * 【波特率 Baud Rate】
 * 波特率是串口通信的速度单位，表示每秒传输多少位数据。
 * 本程序使用 115200，意思是每秒传输 115200 个二进制位。
 * 电脑端的串口监视器也必须设置为 115200，否则看到的是乱码。
 *
 * 硬件连接：
 * 方案 A：使用板载 LED（推荐，最简单）
 * - 大多数 ESP32 开发板的板载 LED 已经连接到 GPIO2，无需额外接线
 *
 * 方案 B：自己外接 LED
 * - ESP32 GPIO2  →  LED 正极（长脚，也叫阳极）
 * - LED 负极（短脚，也叫阴极） →  330Ω 电阻一端
 * - 330Ω 电阻另一端  →  ESP32 GND（地）
 *
 * 为什么要加 330Ω 电阻？
 * LED 导通后内阻很小，如果直接把 GPIO2 和 GND 用 LED 连起来，
 * 电流会很大，可能烧坏 LED 或 ESP32 的 GPIO 引脚。
 * 330Ω 电阻的作用是"限流"，把电流限制在几毫安到十几毫安之间，
 * 这样 LED 能安全工作，亮度也足够肉眼观察。
 *
 * 常见问题与排查：
 * 1. LED 不亮：
 *    - 检查上传时是否选择了正确的开发板型号和串口号
 *    - 检查开发板的板载 LED 是否接在 GPIO2，有些开发板接在 GPIO1、GPIO3、GPIO5 或 GPIO22
 *    - 如果是外接 LED，检查正负极是否接反（长脚是正极）
 *    - 检查电阻是否接触良好
 * 2. 串口监视器看不到文字：
 *    - 把串口监视器右下角的波特率改成 115200
 *    - 检查是否按下了开发板的复位键（部分板子需要复位后串口才输出）
 * 3. 上传失败：
 *    - 按住开发板上的 BOOT 键，再点上传，等出现 Connecting 时松开
 *    - 检查 USB 线是否支持数据传输（有些线只能充电）
 */

// 定义 LED 引脚
// #define 是 C/C++ 的宏定义，意思是"用一个名字代替一个值"。
// 这里用 LED_PIN 代替数字 2，好处是：
// 1. 代码更易读，看到 LED_PIN 就知道这是 LED 引脚
// 2. 如果以后换到其他 GPIO，只需改这一处，不用满篇找数字 2
//
// 不同厂家的开发板，板载 LED 可能在不同引脚：
// - ESP32 DevKitC：通常是 GPIO2
// - NodeMCU-32S：通常是 GPIO2
// - 如果 LED 不亮，可以试试把下面的 2 改成 1、3、5、22 等
#define LED_PIN 2

// setup() 函数：初始化代码只执行一次
// 当开发板上电、复位或重新上传程序后，会从这里开始运行
void setup() {
  // Serial.begin(baudrate) 用来初始化 ESP32 的串口（UART）通信。
  // 串口是 ESP32 和电脑之间传输数据的"通道"，
  // 我们通过 USB 线把 ESP32 连到电脑，电脑就能用串口监视器看到 ESP32 发回的信息。
  // 参数 115200 是波特率，必须和串口监视器设置一致。
  Serial.begin(115200);

  // delay(ms) 让程序暂停一段时间，单位是毫秒（1 毫秒 = 0.001 秒）。
  // 这里等待 1000 毫秒（1 秒），是因为有些开发板上的 USB 转串口芯片需要一点时间建立连接。
  // 如果一上来就打印信息，电脑端的串口监视器可能会错过最开始的几个字。
  delay(1000);

  // Serial.println() 把一段文字发送到串口，并在末尾加上换行符。
  // 这样串口监视器里每一行都是一条独立信息，方便阅读。
  // 打印启动信息可以让我们确认程序已经开始运行。
  Serial.println("================================");
  Serial.println("ESP32 教程 01：数字输出 - Blink");
  Serial.println("================================");

  // pinMode(pin, mode) 用来告诉 ESP32：这个引脚要做什么用。
  // 参数说明：
  // - pin：引脚编号，这里用 LED_PIN（也就是 GPIO2）
  // - mode：工作模式，常用有：
  //   * INPUT（输入模式）：引脚读取外部信号，不主动输出电压
  //   * OUTPUT（输出模式）：引脚主动输出 HIGH 或 LOW
  //   * INPUT_PULLUP（内部上拉输入）：输入模式，同时内部接一个电阻拉到 3.3V
  //  一句话总结：普通 INPUT 是"别人告诉我是什么就是什么"，INPUT_PULLUP 是"没人告诉我的时候我自己默认是 1"。
  //
  // 这里把 LED_PIN 设为 OUTPUT（输出模式），
  // 因为我们要让 ESP32 主动控制 LED 的亮灭。
  // 如果错误地设为 INPUT，引脚只能读取外部信号，无法驱动 LED，LED 就不会亮。
  pinMode(LED_PIN, OUTPUT);

  // 初始化时先把 LED 熄灭，让状态确定。
  // 虽然很多开发板上电时 GPIO 默认是低电平，但显式设置可以避免不确定性。
  digitalWrite(LED_PIN, LOW);
}

// loop() 函数：主循环，会一遍又一遍地执行，直到断电
void loop() {
  // digitalWrite(pin, value) 让引脚输出指定的电平。
  // 参数说明：
  // - pin：引脚编号
  // - value：HIGH 或 LOW
  //   * HIGH：输出高电平（约 3.3V），LED 正极有电压，电流流过，LED 点亮
  //   * LOW：输出低电平（0V），LED 两端几乎没有电压差，LED 熄灭
  digitalWrite(LED_PIN, HIGH);

  // 在串口监视器打印当前状态，方便我们确认程序执行到了这里。
  // 如果没有串口输出，可能怀疑 LED 坏了；有输出就能判断是硬件问题还是软件问题。
  Serial.println("LED 点亮");

  // delay(1000) 让程序暂停 1000 毫秒，也就是 1 秒。
  // 在这段时间里，GPIO2 保持 HIGH，LED 保持点亮。
  // 如果不加 delay，LED 会以极快的速度闪烁，人眼根本看不出来。
  delay(1000);

  // 熄灭 LED：把 GPIO2 设为 LOW
  digitalWrite(LED_PIN, LOW);
  Serial.println("LED 熄灭");

  // 再等待 1 秒，这段时间 LED 保持熄灭
  delay(1000);

  // loop() 函数执行到末尾后，会自动从头再次执行，
  // 所以 LED 会不断重复"亮 1 秒 → 灭 1 秒"的闪烁效果。
}

/*
 * 扩展练习：
 * 1. 修改两个 delay(1000) 的数值，比如改成 200 和 800，观察闪烁频率和亮灭比例变化。
 * 2. 把 LED_PIN 改成其他 GPIO（比如 4、5、18），在外接 LED 上观察效果。
 * 3. 尝试把 digitalWrite(LED_PIN, HIGH) 和 LOW 调换顺序，看看上电后 LED 是先亮还是先灭。
 * 4. 在串口输出里加上当前已闪烁次数，需要定义一个计数器变量并在 loop() 里累加。
 */
