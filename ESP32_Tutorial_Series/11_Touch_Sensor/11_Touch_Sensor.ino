/*
 * ESP32 教程系列 11：触摸传感器 —— 不用机械按键也能控制
 * 
 * 学习目标：
 * 1. 理解什么是"电容触摸"，以及 ESP32 为什么能直接做触摸检测
 * 2. 学会用 touchRead() 读取触摸引脚的电容变化数值
 * 3. 学会用程序判断"是否被触摸"，并用触摸控制 LED 的亮灭
 * 4. 理解"阈值""状态检测""消抖"这些常用概念
 * 
 * 前置知识：
 * - 已经会用 pinMode()、digitalWrite() 控制 LED
 * - 已经会用 Serial.print() 查看串口输出
 * 
 * 硬件连接：
 * - ESP32 GPIO2  →  LED 正极（长脚）
 * - LED 负极（短脚） →  330Ω 电阻  →  GND
 * - ESP32 GPIO4  →  一根导线、铜箔片或硬币（作为触摸电极）
 * - 注意：触摸电极只需要一根导线连着 GPIO4 即可，不需要接电源或地
 * 
 * 为什么触摸引脚不需要接电阻？
 * 因为电容触摸测量的不是电压电流，而是引脚对地的"等效电容"。
 * 人手靠近时，人体本身相当于一个接地的"大电容"，会改变引脚周围电场，
 * 芯片检测到这个变化，就认为有触摸发生。
 */

// 宏定义：给引脚起个有意义的名字，方便以后修改和阅读
#define LED_PIN     2    // 板载 LED 通常接 GPIO2
#define TOUCH_PIN   4    // 触摸引脚选 GPIO4（ESP32 经典款可用触摸引脚之一）

// 触摸阈值：当 touchRead() 读数低于这个值时，我们认为"被触摸了"
// 注意：这个值不是固定的！不同板子、不同导线长度、不同环境湿度都会影响读数。
// 建议先上传程序，打开串口监视器看未触摸和触摸时的数值，再调整这个阈值。
#define TOUCH_THRESHOLD  30

// lastTouchState 用来保存"上一次循环"的触摸状态。
// 为什么需要它？因为我们通常只想检测"按下的那一瞬间"，
// 而不是手指一直按着时 LED 不断闪烁。
// 这种从"没按"变成"按下"的检测叫做"上升沿检测"或"边沿检测"。
bool lastTouchState = false;

void setup() {
  // Serial.begin(115200) 初始化串口，波特率 115200。
  // 串口是 ESP32 和电脑"说话"的通道，我们可以通过串口观察触摸数值。
  Serial.begin(115200);

  // delay(1000) 等待 1 秒，让串口监视器有时间打开，
  // 否则开头的提示信息可能会被漏掉。
  delay(1000);

  Serial.println("================================");
  Serial.println("ESP32 教程 11：触摸传感器");
  Serial.println("================================");

  // pinMode(pin, mode) 设置引脚工作模式。
  // LED_PIN 设为 OUTPUT（输出模式），因为我们要主动控制 LED 亮灭。
  pinMode(LED_PIN, OUTPUT);

  // 初始化时先把 LED 关掉，避免一上电就亮。
  digitalWrite(LED_PIN, LOW);

  Serial.println("请用手指触摸连接 GPIO4 的导线或金属片，观察串口数值变化");
  Serial.println("建议先不急着触发 LED，先观察"未触摸"和"触摸"时的典型数值");
}

void loop() {
  // touchRead(TOUCH_PIN) 读取 GPIO4 的电容触摸值。
  // 
  // 什么是电容触摸？
  // 电容触摸（Capacitive Touch）不是通过机械接触来检测，
  // 而是通过检测引脚对地的"等效电容"变化来判断是否有人体靠近。
  // 人手含有大量水分，可以看作一个导体；当手指靠近触摸电极时，
  // 相当于给电极增加了一个并联电容，总电容变大。
  // ESP32 内部电路测量这个电容变化，并把它转换成一个数值返回。
  //
  // 返回值范围大概是 0 ~ 100（具体因板子而异）。
  // 数值越小，代表电容越大，说明越接近"被触摸"状态。
  // 一般规律：
  // - 未触摸时：数值较大，约 50 ~ 100
  // - 手指靠近或轻触时：数值明显变小，可能小于 20
  int touchValue = touchRead(TOUCH_PIN);

  // 用阈值把连续变化的触摸数值变成"是/否"两种状态。
  // 小于阈值就认为被触摸，否则认为没被触摸。
  // 为什么要用阈值？因为触摸值不是 0 或 1 这种明确的数字，而是一个范围，
  // 我们需要人为划定一条分界线。
  bool isTouched = (touchValue < TOUCH_THRESHOLD);

  // 检测"按下瞬间"：现在被触摸了，并且上一次没被触摸。
  // 这种写法叫做"边沿检测"，只在状态变化的瞬间执行一次。
  // 如果不加这个判断，只要手指一直按着，每次循环都会翻转 LED，
  // 结果 LED 会以极快速度闪烁，看起来就像一直亮着或乱闪。
  if (isTouched && !lastTouchState) {
    // digitalRead(LED_PIN) 读取 LED 当前状态（HIGH 或 LOW），
    // 前面加 ! 表示取反，实现"当前亮就熄灭，当前灭就点亮"。
    digitalWrite(LED_PIN, !digitalRead(LED_PIN));

    Serial.print("检测到触摸，LED 状态切换为：");
    Serial.println(digitalRead(LED_PIN) == HIGH ? "点亮" : "熄灭");

    // delay(200) 是软件消抖。
    // 人手触摸不是干净利落的 0/1 变化，手指靠近过程中数值会反复波动，
    // 可能导致程序把一次触摸误判成多次。延时 200ms 可以跳过这段不稳定期。
    delay(200);
  }

  // 更新"上一次状态"，为下一次循环做准备。
  lastTouchState = isTouched;

  // 每 200ms 打印一次触摸值，方便我们观察和调整阈值。
  // static 修饰的变量只在第一次进入函数时初始化，之后保持上次值，
  // 这样可以记录"上次打印的时间"。
  static unsigned long lastPrint = 0;
  if (millis() - lastPrint > 200) {
    lastPrint = millis();
    Serial.print("触摸值：");
    Serial.println(touchValue);
  }
}

/*
 * 排查提示：
 * 1. 如果触摸没反应：
 *    - 先打开串口监视器，看触摸值有没有明显变化。
 *    - 如果变化很小，试着把 TOUCH_THRESHOLD 调大（比如 50 或 60）。
 *    - 确保导线长度不要太长，长导线容易受干扰。
 *
 * 2. 如果 LED 自己乱闪：
 *    - 可能是阈值设得太低，环境干扰被误判为触摸。
 *    - 把 TOUCH_THRESHOLD 调小一点。
 *    - 给触摸电极加一小块金属片或锡箔纸，比裸露导线稳定。
 *
 * 3. 触摸引脚没有反应：
 *    - 确认使用的是 ESP32 支持的触摸引脚：
 *      GPIO0、GPIO2、GPIO4、GPIO12、GPIO13、GPIO14、GPIO15、GPIO27、GPIO32、GPIO33
 *    - GPIO6 ~ GPIO11 连接内部 Flash，绝对不要用。
 *
 * 4. 为什么有些 GPIO 不能做触摸？
 *    - 不是所有 GPIO 都连到 ESP32 内部的电容触摸感应单元，
 *      只有上面列出的 10 个引脚支持 touchRead()。
 */

